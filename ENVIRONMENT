##########################################################################
#
# Inteliweb AI — ComfyUI Pinokio Installer
# https://www.youtube.com/@InteliwebAI
#
# QUICK START (recommended for most users):
#
# COMFY_VER=latest
# PYTHON_VER=3.12
# TORCH_VARIANT=auto
# COMFY_PORT=8188
# COMFY_GPU_DEVICE=auto
# COMFY_CLI_VER=1.12.0
#
##########################################################################

##########################################################################
# COMFYUI VERSION
#
# Allowed values:
# - latest  → install the newest stable ComfyUI release (RECOMMENDED)
# - v0.18.2 → example of a specific release tag
#
# Notes:
# - Use "latest" for most users.
# - Use a fixed version only when an older workflow requires it.
##########################################################################
COMFY_VER=latest

##########################################################################
# PYTHON VERSION
#
# Allowed values:
# - 3.10 → best compatibility with older custom nodes
# - 3.11 → good balance
# - 3.12 → RECOMMENDED for most users
# - 3.13 → only if your nodes already support it
##########################################################################
PYTHON_VER=3.12

##########################################################################
# TORCH VARIANT — PyTorch / GPU backend
#
# RECOMMENDED FOR MOST USERS
# - auto
#
# Default auto behavior:
# - Windows NVIDIA → torch 2.10.0 + cu130
# - Linux NVIDIA   → torch 2.10.0 + cu130
# - Windows AMD    → DirectML
# - Linux AMD      → CPU fallback
# - Apple Silicon  → MPS build
# - Intel Mac      → CPU build
#
# NVIDIA options:
# - latest-cu130
# - 2.10.0-cu130
# - 2.9.1-cu128
# - 2.8.0-cu128
#
# AMD options:
# - directml       → Windows AMD
# - 2.7.0-rocm6.3 → Linux AMD with ROCm configured
#
# CPU option:
# - cpu            → use this when the computer has no supported GPU
##########################################################################
TORCH_VARIANT=auto

##########################################################################
# COMFYUI PORT
#
# - 8188 → default ComfyUI port
# - Use a different port for each simultaneous Pinokio installation.
#
# Examples:
# - First installation  → 8188
# - Second installation → 8189
##########################################################################
COMFY_PORT=8188

##########################################################################
# GPU DEVICE
#
# - auto → use the default GPU (RECOMMENDED for most users)
# - 0    → first GPU
# - 1    → second GPU
#
# Only one GPU number is accepted. Do not use values such as 0,1.
# This setting is ignored when TORCH_VARIANT=cpu and on macOS.
#
# Two installations on the same GPU:
# - Installation 1: COMFY_PORT=8188 and COMFY_GPU_DEVICE=0
# - Installation 2: COMFY_PORT=8189 and COMFY_GPU_DEVICE=0
#
# Two installations on different GPUs:
# - Installation 1: COMFY_PORT=8188 and COMFY_GPU_DEVICE=0
# - Installation 2: COMFY_PORT=8189 and COMFY_GPU_DEVICE=1
##########################################################################
COMFY_GPU_DEVICE=auto

##########################################################################
# COMFY-CLI VERSION
#
# comfy-cli supervises ComfyUI and allows ComfyUI-Manager to perform manual
# and automatic restarts without terminating the Pinokio Start session.
#
# 1.12.0 is the version validated with this installer branch.
##########################################################################
COMFY_CLI_VER=1.12.0
